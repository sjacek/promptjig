{
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "label": {"type": "string"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/node"}}
      }
    },
    "alias": {"$ref": "#/$defs/node"}
  },
  "properties": {
    "class": {"type": "string"},
    "getClass": {"type": "string"},
    "hyphen-name": {"type": "string"},
    "string": {"type": "string", "enum": ["in-progress", "done"]},
    "state": {"type": ["string", "null"], "enum": ["yes", "no", null]},
    "nothing": {"type": ["string", "null"], "enum": [null]},
    "count": {"type": "integer"},
    "amount": {"type": "number"},
    "day": {"type": ["string", "null"], "format": "date"},
    "timestamp": {"type": "string", "format": "date-time"},
    "integerEnum": {"type": "integer", "enum": [1, 2]},
    "numberEnum": {"type": "number", "enum": [1, 2.5]},
    "booleanEnum": {"type": "boolean", "enum": [true, false]},
    "codes": {"type": "array", "items": {"type": "string", "enum": ["01-U", "05-R"]}},
    "nullableArray": {"type": ["array", "null"], "items": {"type": "string"}},
    "nullableItems": {"type": "array", "items": {"type": ["string", "null"]}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/alias"}},
    "empty": {"type": "object", "properties": {}, "additionalProperties": false}
  }
}
