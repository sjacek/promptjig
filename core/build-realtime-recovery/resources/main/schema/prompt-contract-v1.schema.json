{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptjig:contract:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["promptContract", "id", "version", "messages", "input", "output"],
  "properties": {
    "promptContract": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "description": {"type": "string"},
    "sensitivity": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "messages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "template"],
        "properties": {
          "role": {"enum": ["system", "user"]},
          "template": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.st$"}
        }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["schema"],
      "properties": {"schema": {"$ref": "#/$defs/objectSchema"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["format", "schema"],
      "properties": {
        "format": {"const": "json"}, "strict": {"type": "boolean"},
        "schema": {"$ref": "#/$defs/objectSchema"}
      }
    }
  },
  "$defs": {
    "objectSchema": {
      "allOf": [
        {"$ref": "#/$defs/schema"},
        {"required": ["type", "properties", "additionalProperties"], "properties": {"type": {"const": "object"}}}
      ]
    },
    "schema": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "type": {
          "oneOf": [
            {"enum": ["string", "boolean", "integer", "number", "object", "array"]},
            {"type": "array", "prefixItems": [{"enum": ["string", "boolean", "integer", "number", "object", "array"]}, {"const": "null"}], "minItems": 2, "maxItems": 2}
          ]
        },
        "enum": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "boolean", "integer", "number", "null"]}},
        "format": {"enum": ["date", "date-time"]},
        "pattern": {"type": "string"},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/schema"}},
        "required": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "additionalProperties": {"const": false},
        "items": {"$ref": "#/$defs/schema"},
        "$defs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/schema"}},
        "$ref": {"type": "string", "pattern": "^#/\\$defs(?:/[^/]+)+$"}
      },
      "anyOf": [{"required": ["type"]}, {"required": ["$ref"]}]
    }
  }
}
