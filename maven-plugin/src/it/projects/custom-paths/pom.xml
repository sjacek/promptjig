<?xml version="1.0" ?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sjacek.promptjig.test</groupId>
    <artifactId>promptjig-integration-testdata</artifactId>
    <version>1.0</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>custom-paths-testdata</artifactId>
  <properties>
    <promptjig.jackson>v3</promptjig.jackson>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>io.github.sjacek.promptjig</groupId>
        <artifactId>promptjig-maven-plugin</artifactId>
        <version>${promptjig.version}</version>
        <configuration>
          <packageName>${promptjig.packageName}</packageName>
          <jackson>${promptjig.jackson}</jackson>
          <source>${project.basedir}/src/main/resources/contracts</source>
          <lockFile>${project.basedir}/contracts.lock.json</lockFile>
          <outputDirectory>${project.build.directory}/custom/generated</outputDirectory>
          <reportDirectory>${project.build.directory}/custom/reports</reportDirectory>
          <resourcePrefix>contracts</resourcePrefix>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>validate</goal>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
